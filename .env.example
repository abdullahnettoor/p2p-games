# Optional Self-Hosted PeerJS Signaling Server
# If unset, the app connects to the public 0.peerjs.com broker.
# When running `npm run peer-server` locally:
# NEXT_PUBLIC_PEER_HOST=localhost
# NEXT_PUBLIC_PEER_PORT=9000
# NEXT_PUBLIC_PEER_PATH=/
# NEXT_PUBLIC_PEER_SECURE=false

# When deployed to Cloudflare Worker (see workers/signaling/):
# NEXT_PUBLIC_PEER_HOST=p2p-games-signaling.<your-subdomain>.workers.dev
# NEXT_PUBLIC_PEER_PORT=443
# NEXT_PUBLIC_PEER_PATH=/
# NEXT_PUBLIC_PEER_SECURE=true

# Optional Signaling Ping Interval (default: 5000ms)
# NEXT_PUBLIC_PEER_PING_INTERVAL_MS=5000

# Optional TURN Relay Configuration (see docs/adr/0007-ice-configuration-and-turn-fallback.md)
# NEXT_PUBLIC_TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=myuser
# NEXT_PUBLIC_TURN_CREDENTIAL=mypassword
