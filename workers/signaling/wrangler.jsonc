{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "p2p-games-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_HUB",
        "class_name": "SignalingHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
